# Secreto para firmar los JWT.
# En producción es OBLIGATORIO y debe tener 32 caracteres o más
# (por ejemplo: openssl rand -hex 32).
# En desarrollo, si no se define, la API genera uno aleatorio al arrancar
# (las sesiones se pierden en cada reinicio).
JWT_SECRET=

# Orígenes permitidos por CORS, separados por comas (se aplica en la fase D6).
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

PORT=3000
